# Copiar en el servidor (cPanel) como .env dentro de soporte.exactolp.mx
# cp .env.production.example .env
# php artisan key:generate
# Completar los valores marcados con CAMBIAR_

APP_NAME=ExactoLaravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://soporte.exactolp.mx

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=joses16_exacto
DB_USERNAME=CAMBIAR_usuario_mysql
DB_PASSWORD=CAMBIAR_password_mysql

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo Exacto (cPanel → Cuentas de correo → Conectar dispositivos)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.exactolp.mx
MAIL_PORT=587
MAIL_USERNAME=notificaciones@exacto.com.mx
MAIL_PASSWORD=CAMBIAR_password_buzon
MAIL_FROM_ADDRESS="notificaciones@exacto.com.mx"
MAIL_FROM_NAME="Exacto"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Exacto
EXACTO_LOGIN_ALLOW_PLAINTEXT_PASSWORD=0
EXACTO_CATALOGO_SERSOP_GUEST=false
# Si migras datos cifrados desde local, usa el MISMO valor que en tu .env local.
# Si es instalación nueva, genera uno: php -r "echo bin2hex(random_bytes(32));"
EXACTO_TELEFONO_SECRET=CAMBIAR_o_copiar_desde_local
EXACTO_LEGACY_APP_URL=https://exactolp.mx
EXACTO_LARAVEL_PUBLIC_URL=https://soporte.exactolp.mx
EXACTO_SHOW_LEGACY_ESCAPE_HATCH=false
EXACTO_CUTOVER_BANNER=

# Sesión: minutos sin actividad antes de cerrar sesión (default 480 = 8 horas).
EXACTO_SESSION_IDLE_MINUTES=480
# Minutos sin actividad para considerar a un técnico "en línea" en impersonación.
EXACTO_PRESENCE_ONLINE_MINUTES=10
# Sesión única por cuenta: true = un solo dispositivo; false = varios dispositivos a la vez.
EXACTO_SESSION_SINGLE_DEVICE=false

# WhatsApp (opcional; dejar false hasta tener credenciales Meta)
WHATSAPP_CLOUD_ENABLED=false
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# App Secret de Meta (valida la firma del webhook entrante; recomendado para el chat de Soporte)
WHATSAPP_APP_SECRET=
FACEBOOK_APP_ID=
WHATSAPP_LANGUAGE=es_MX
WHATSAPP_DEFAULT_COUNTRY_CODE=52
WHATSAPP_TEMPLATE_INCLUDE_DOCUMENT=true
WHATSAPP_TEMPLATE_RECEPCION=
WHATSAPP_TEMPLATE_TERMINADO=
WHATSAPP_TEMPLATE_ENTREGADO=
