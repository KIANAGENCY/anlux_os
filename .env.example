APP_NAME=Anlux
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Producción subdominio (cPanel soporte.anlux.mx):
# APP_URL=https://soporte.anlux.mx
# APP_ENV=production
# APP_DEBUG=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="notificaciones@anlux.mx"
MAIL_FROM_NAME="Anlux"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Anlux (migración / cutover Fase 5) ---
# URL base del PHP legacy, sin barra final (escape hatch y documentación).
ANLUX_LEGACY_APP_URL=http://127.0.0.1/anlux
# Producción: legacy en dominio principal, Laravel en subdominio soporte:
# ANLUX_LEGACY_APP_URL=https://anlux.mx
# ANLUX_LARAVEL_PUBLIC_URL=https://soporte.anlux.mx
# Texto opcional durante piloto (una o varias líneas; se escapa HTML).
ANLUX_CUTOVER_BANNER=
# true = muestra enlaces a órdenes/admin/login del legacy (abre en nueva pestaña; sesión aparte).
ANLUX_SHOW_LEGACY_ESCAPE_HATCH=false

# En el .env del PHP legacy (anlux), no aquí: activar redirección opcional al front Laravel.
# ANLUX_REDIRECT_LEGACY_TO_LARAVEL=1
# ANLUX_LARAVEL_PUBLIC_URL=http://127.0.0.1/anlux_laravel/public
#
# Solo con APP_ENV=local: permite /admin/catalogo-sersop sin sesión (solo desarrollo).
# ANLUX_CATALOGO_SERSOP_GUEST=false

# Sesión: minutos sin actividad antes de cerrar sesión (default 480 = 8 horas).
# ANLUX_SESSION_IDLE_MINUTES=480
# Minutos sin actividad para considerar a un técnico "en línea" en impersonación (default 10).
# ANLUX_PRESENCE_ONLINE_MINUTES=10
# Sesión única por cuenta: true = solo un dispositivo a la vez; false (default) = varios dispositivos.
ANLUX_SESSION_SINGLE_DEVICE=false

# WhatsApp automático al guardar/cambiar estatus (false = pausado; solo correo)
ANLUX_WHATSAPP_NOTIFICATIONS=
# Si ANLUX_WHATSAPP_NOTIFICATIONS está vacío, sigue WHATSAPP_CLOUD_ENABLED.

# WhatsApp Cloud API
WHATSAPP_CLOUD_ENABLED=false
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=v20.0
# ID del numero de WhatsApp en Meta (WhatsApp > API Setup > Phone number ID). NO es el App ID.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# App Secret de Meta (valida la firma del webhook entrante; recomendado para el chat de Soporte)
WHATSAPP_APP_SECRET=
# App ID de Meta (developers.facebook.com > tu app > Configuracion > Basica). NO usar WHATSAPP_PHONE_NUMBER_ID aqui.
FACEBOOK_APP_ID=
WHATSAPP_LANGUAGE=es_MX
WHATSAPP_DEFAULT_COUNTRY_CODE=52
# Plantillas Meta (Utilidad): encabezado Documento + cuerpo:
# Hola, tu orden de servicio con folio {{1}} fue registrada con estatus {{2}}.
# {{1}} = folio (ej. OS-2026-005), {{2}} = estatus (Recepción, Terminado, Entregado)
WHATSAPP_TEMPLATE_INCLUDE_DOCUMENT=true
WHATSAPP_HTTP_TIMEOUT=180
WHATSAPP_HTTP_CONNECT_TIMEOUT=60
WHATSAPP_TEMPLATE_RECEPCION=orden_recepcion
WHATSAPP_TEMPLATE_TERMINADO=orden_terminado
WHATSAPP_TEMPLATE_ENTREGADO=orden_entregado

# --- Marca / legal (cliente) ---
ANLUX_COMPANY_LEGAL_NAME="La empresa titular del sistema"
ANLUX_PRIVACY_EMAIL=privacidad@ejemplo.com
ANLUX_COMPANY_JURISDICTION=Mexico

# --- Vercel (opcional) ---
# Guía: deploy/VERCEL.md  |  plantilla env: .env.vercel.example
# Requiere MySQL externo; no uses SESSION_DRIVER=file en serverless.
