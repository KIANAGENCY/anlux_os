# Hosting: si el Document Root es la raíz del proyecto (no public/), redirige a public/
# Subdominio recomendado: soporte.exactolp.mx → Document Root = .../public/
<IfModule mod_rewrite.c>
    DirectoryIndex index.php
    RewriteEngine On
    RewriteBase /

    RewriteCond %{REQUEST_URI} !^/public/ [NC]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
