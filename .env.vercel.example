# Copia estos valores al panel de Vercel → Settings → Environment Variables
# (Production / Preview). No subas secretos a git.

APP_NAME=Anlux
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:PEGA_AQUI_php_artisan_key_generate
APP_URL=https://TU-PROYECTO.vercel.app

LOG_CHANNEL=stderr
LOG_LEVEL=error

# MySQL/MariaDB externo (obligatorio). Ejemplos: PlanetScale, Railway, Aiven, cPanel remoto.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=notificaciones@tudominio.com
MAIL_FROM_NAME=Anlux

# Caches en /tmp (también vienen en vercel.json)
APP_CONFIG_CACHE=/tmp/config.php
APP_EVENTS_CACHE=/tmp/events.php
APP_PACKAGES_CACHE=/tmp/packages.php
APP_ROUTES_CACHE=/tmp/routes.php
APP_SERVICES_CACHE=/tmp/services.php
VIEW_COMPILED_PATH=/tmp/views
