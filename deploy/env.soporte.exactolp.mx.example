# Copiar a .env en el servidor (soporte.exactolp.mx)
# Ajustar DB_* con los valores de cPanel (usuario MySQL de joses16_exacto, etc.)

APP_NAME=Exacto
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://soporte.exactolp.mx

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=joses16_exacto
DB_USERNAME=joses16_admin
DB_PASSWORD=CAMBIAR

SESSION_DRIVER=database
SESSION_DOMAIN=null

QUEUE_CONNECTION=database

EXACTO_LEGACY_APP_URL=https://exactolp.mx
EXACTO_SHOW_LEGACY_ESCAPE_HATCH=false
